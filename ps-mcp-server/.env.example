# ──────────────────────────────────────────────────────────────────────────────
# PeopleSoft MCP Server — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to source control.
# ──────────────────────────────────────────────────────────────────────────────

# ── Mock mode ─────────────────────────────────────────────────────────────────
# Set to true to skip Oracle entirely and return realistic mock data.
# Useful for local development, CI, and demos without a DB connection.
# Falls back to true automatically if the DB pool fails to initialise.
USE_MOCK=true

# ── Oracle DB credentials ──────────────────────────────────────────────────────
# PeopleSoft database read-only user account.
# Use a dedicated account with SELECT-only grants on PS* meta tables.
DB_USER=ps_readonly

# Password for DB_USER.
DB_PASSWORD=your-password

# ── Connection method (choose ONE) ────────────────────────────────────────────
#
# Option A — TNS alias (preferred for PeopleSoft environments)
# ─────────────────────────────────────────────────────────────
# TNS_ADMIN: directory containing tnsnames.ora and sqlnet.ora.
# DB_TNS_ALIAS: the alias name as it appears in tnsnames.ora.
# When DB_TNS_ALIAS is set, DB_HOST / DB_PORT / DB_SERVICE are ignored.
#
TNS_ADMIN=/oracle/network/admin
DB_TNS_ALIAS=HRPRD

# Option B — Easy Connect string
# ─────────────────────────────────────────────────────────────
# Used when DB_TNS_ALIAS is not set.
# The PeopleSoft database host (IP or hostname).
DB_HOST=your-oracle-host

# Oracle listener port (default: 1521).
DB_PORT=1521

# Oracle service name (e.g. PSFT, HRPRD, FSPRD).
# This is the value after the slash in an Easy Connect string.
DB_SERVICE=PSFT
